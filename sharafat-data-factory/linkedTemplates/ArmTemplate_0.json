		{
			"name": "[concat(parameters('factoryName'), '/dataflow1')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DelimitedText1",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "cleaned_output_csv",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "aggregate1"
						},
						{
							"name": "sort1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          student_id as string,",
						"          student_name as string,",
						"          class as string,",
						"          subject as string,",
						"          marks as string,",
						"          city as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 derive(student_name = initCap(trim(student_name)),",
						"          class = initCap(trim(class)),",
						"          subject = initCap(trim(subject)),",
						"          city = initCap(trim(city)),",
						"          student_id = toInteger(trim(student_id))) ~> derivedColumn1",
						"derivedColumn1 aggregate(groupBy(student_id),",
						"     student_name = first(student_name),",
						"          class = first(class),",
						"          subject = first(subject),",
						"          marks = first(marks),",
						"          city = first(city)) ~> aggregate1",
						"aggregate1 sort(asc(student_id, true)) ~> sort1",
						"sort1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DelimitedText1')]",
				"[concat(variables('factoryId'), '/datasets/cleaned_output_csv')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_bronze_to_silver')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_bronze_raw",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_silver",
								"type": "DatasetReference"
							},
							"name": "silver",
							"description": "this is silver sink"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "sort1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          tracking_number as string,",
						"          order_reference as string,",
						"          booking_date as string,",
						"          customer_name as string,",
						"          contact_number as string,",
						"          shipping_address as string,",
						"          destination_city as string,",
						"          item_description as string,",
						"          quantity as string,",
						"          cod_amount_pkr as string,",
						"          payment_type as string,",
						"          weight_kg as string,",
						"          shipping_cost as string,",
						"          delivery_status as string,",
						"          assigned_rider as string,",
						"          last_updated as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 derive(customer_name = initCap(trim(customer_name)),",
						"          destination_city = initCap(trim(destination_city)),",
						"          payment_type = upper(trim(payment_type)),",
						"          delivery_status = initCap(trim(delivery_status)),",
						"          shipping_address = lower(trim(shipping_address))) ~> derivedColumn1",
						"derivedColumn1 sort(asc(tracking_number, true)) ~> sort1",
						"sort1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> silver"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_bronze_raw')]",
				"[concat(variables('factoryId'), '/datasets/ds_silver')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_silver_to_gold')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_silver",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_gold",
								"type": "DatasetReference"
							},
							"name": "sink1",
							"description": "Add sink dataset gold(final)"
						}
					],
					"transformations": [
						{
							"name": "aggregate1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          tracking_number as string,",
						"          order_reference as string,",
						"          booking_date as timestamp,",
						"          customer_name as string,",
						"          contact_number as string,",
						"          shipping_address as string,",
						"          destination_city as string,",
						"          item_description as string,",
						"          quantity as short,",
						"          cod_amount_pkr as short,",
						"          payment_type as string,",
						"          weight_kg as double,",
						"          shipping_cost as short,",
						"          delivery_status as string,",
						"          assigned_rider as string,",
						"          last_updated as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 aggregate(groupBy(assigned_rider),",
						"     total_orders = count(1),",
						"          total_shipping_cost = sum(shipping_cost),",
						"          total_cod_amount = sum(cod_amount_pkr),",
						"          avg_weight = avg(weight_kg)) ~> aggregate1",
						"aggregate1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_silver')]",
				"[concat(variables('factoryId'), '/datasets/ds_gold')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pipeline2')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Data flow1",
						"type": "ExecuteDataFlow",
						"dependsOn": [
							{
								"activity": "source",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
