		{
			"name": "[concat(parameters('factoryName'), '/dataflow1')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DelimitedText1",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "cleaned_output_csv",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "aggregate1"
						},
						{
							"name": "sort1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          student_id as string,",
						"          student_name as string,",
						"          class as string,",
						"          subject as string,",
						"          marks as string,",
						"          city as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 derive(student_name = initCap(trim(student_name)),",
						"          class = initCap(trim(class)),",
						"          subject = initCap(trim(subject)),",
						"          city = initCap(trim(city)),",
						"          student_id = toInteger(trim(student_id))) ~> derivedColumn1",
						"derivedColumn1 aggregate(groupBy(student_id),",
						"     student_name = first(student_name),",
						"          class = first(class),",
						"          subject = first(subject),",
						"          marks = first(marks),",
						"          city = first(city)) ~> aggregate1",
						"aggregate1 sort(asc(student_id, true)) ~> sort1",
						"sort1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DelimitedText1')]",
				"[concat(variables('factoryId'), '/datasets/cleaned_output_csv')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_bronze_to_silver')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_bronze_raw",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_silver",
								"type": "DatasetReference"
							},
							"name": "sink1"
						},
						{
							"dataset": {
								"referenceName": "ds_gold",
								"type": "DatasetReference"
							},
							"name": "sink2"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "sort1"
						},
						{
							"name": "aggregate1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          tracking_number as string,",
						"          order_reference as string,",
						"          booking_date as string,",
						"          customer_name as string,",
						"          contact_number as string,",
						"          shipping_address as string,",
						"          destination_city as string,",
						"          item_description as string,",
						"          quantity as string,",
						"          cod_amount_pkr as string,",
						"          payment_type as string,",
						"          weight_kg as string,",
						"          shipping_cost as string,",
						"          delivery_status as string,",
						"          assigned_rider as string,",
						"          last_updated as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 derive(customer_name = initCap(trim(customer_name)),",
						"          destination_city = initCap(trim(destination_city)),",
						"          payment_type = upper(trim(payment_type)),",
						"          delivery_status = initCap(trim(delivery_status)),",
						"          shipping_address = lower(trim(shipping_address))) ~> derivedColumn1",
						"derivedColumn1 sort(asc(tracking_number, true)) ~> sort1",
						"sort1 aggregate(groupBy(destination_city),",
						"     total_orders = count(tracking_number),",
						"          total_revenue = sum(toDecimal(shipping_cost))) ~> aggregate1",
						"sort1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['silver_clean_data.csv'],",
						"     truncate: true,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> sink1",
						"aggregate1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['gold_summary.csv'],",
						"     truncate: true,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> sink2"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_bronze_raw')]",
				"[concat(variables('factoryId'), '/datasets/ds_silver')]",
				"[concat(variables('factoryId'), '/datasets/ds_gold')]"
			]
		},
