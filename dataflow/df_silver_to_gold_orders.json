{
	"name": "df_silver_to_gold_orders",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_silver_gold",
						"type": "DatasetReference"
					},
					"name": "silvertogold"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "CountByDate"
				}
			],
			"scriptLines": [
				"source(output(",
				"          order_id as string,",
				"          customer_name as string,",
				"          city as string,",
				"          order_date as string,",
				"          row_num as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> silvertogold",
				"silvertogold aggregate(groupBy(order_date),",
				"     total_orders = count(1)) ~> CountByDate"
			]
		}
	}
}