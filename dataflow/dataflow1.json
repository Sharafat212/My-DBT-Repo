{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "cleaned_output_csv",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          student_id as string,",
				"          student_name as string,",
				"          class as string,",
				"          subject as string,",
				"          marks as string,",
				"          city as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(student_name = trim(student_name),",
				"          class = trim(class),",
				"          subject = trim(subject),",
				"          city = trim(city)) ~> derivedColumn1",
				"derivedColumn1 aggregate(groupBy(student_id),",
				"     student_name = first(student_name),",
				"          class = first(class),",
				"          subject = first(subject),",
				"          marks = first(marks),",
				"          city = first(city)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}