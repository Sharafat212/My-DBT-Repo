{
	"name": "df_silver_to_gold",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_silver",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          tracking_number as string,",
				"          order_reference as string,",
				"          booking_date as timestamp,",
				"          customer_name as string,",
				"          contact_number as string,",
				"          shipping_address as string,",
				"          destination_city as string,",
				"          item_description as string,",
				"          quantity as short,",
				"          cod_amount_pkr as short,",
				"          payment_type as string,",
				"          weight_kg as double,",
				"          shipping_cost as short,",
				"          delivery_status as string,",
				"          assigned_rider as string,",
				"          last_updated as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 aggregate(groupBy(assigned_rider),",
				"     total_orders = count(1),",
				"          total_shipping_cost = sum(shipping_cost),",
				"          total_cod_amount = sum(cod_amount_pkr),",
				"          avg_weight = avg(weight_kg)) ~> aggregate1"
			]
		}
	}
}