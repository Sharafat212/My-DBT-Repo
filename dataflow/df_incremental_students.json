{
	"name": "df_incremental_students",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze1_to_silver1",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_bronze1_to_silver1",
						"type": "DatasetReference"
					},
					"name": "silver1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1",
					"description": "Creating/updating the columns 'tracking_number, order_reference, booking_date, customer_name, "
				},
				{
					"name": "sort1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          order_id as string,",
				"          customer_name as string,",
				"          city as string,",
				"          order_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(order_id = iif(isNull(order_id), '', upper(trim(order_id))),",
				"          customer_name = iif(isNull(customer_name), '', trim(customer_name)),",
				"          city = iif(isNull(city), '', trim(city)),",
				"          order_date = trim(order_date)) ~> derivedColumn1",
				"derivedColumn1 sort(asc(order_id, true)) ~> sort1",
				"sort1 aggregate(groupBy(order_id),",
				"     city = count(city)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          order_id as string,",
				"          customer_name as string,",
				"          city as string,",
				"          order_date as string",
				"     ),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> silver1"
			]
		}
	}
}